<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pascal.jarvis.mobile-gateway</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>-m</string>
        <string>dashboard.mobile_gateway</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__JARVIS_DIR__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>PYTHONPATH</key>
        <string>__JARVIS_DIR__</string>
    </dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>/tmp/jarvis-mobile-gateway.log</string>
    <key>StandardErrorPath</key><string>/tmp/jarvis-mobile-gateway.log</string>
    <key>ThrottleInterval</key><integer>10</integer>
</dict>
</plist>
