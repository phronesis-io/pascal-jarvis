<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pascal.jarvis.mobile-gateway</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON_BIN__</string>
        <string>-m</string>
        <string>dashboard.mobile_gateway</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__JARVIS_DIR__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__PYTHON_DIR__:__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>PYTHONPATH</key>
        <string>__JARVIS_DIR__</string>
        <key>TAILSCALE_SOCKET</key>
        <string>__HOME__/.local/state/tailscaled/tailscaled.sock</string>
        <key>JARVIS_TAILSCALE_AUTO_SERVE</key>
        <string>1</string>
        <key>JARVIS_TAILSCALE_MODE</key>
        <string>funnel</string>
        <key>JARVIS_TRUST_PROXY_HEADERS</key>
        <string>1</string>
    </dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>/tmp/jarvis-mobile-gateway.log</string>
    <key>StandardErrorPath</key><string>/tmp/jarvis-mobile-gateway.log</string>
    <key>ThrottleInterval</key><integer>10</integer>
</dict>
</plist>
